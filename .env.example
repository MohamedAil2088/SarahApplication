# Server Configuration
PORT=3000
NODE_ENV=development
APPLECATION_NAME="SARAH_APP"

# Database Configuration (MongoDB)
DB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>"
DB_NAME="APP-SRAHA"

# Cache Configuration (Redis)
REDIS_URI="rediss://default:<password>@<host>:6379"

# Security & Encryption (AES-256-CBC)
SALT=12
ENC_KEY="0123456789abcdef0123456789abcdef"
IV_LENGTH=16

# JWT Access Tokens
ACCESS_ADMIN_TOKEN_SIGNATURE="your-admin-access-token-secret"
ACCESS_USER_TOKEN_SIGNATURE="your-user-access-token-secret"
ACCESS_TOKEN_EXPIERS_IN=1800

# JWT Refresh Tokens
REFRESH_ADMIN_TOKEN_SIGNATURE="your-admin-refresh-token-secret"
REFRESH_USER_TOKEN_SIGNATURE="your-user-refresh-token-secret"
REFRESH_TOKEN_EXPIERS_IN=3153600

# Email Service (Nodemailer)
APP_EMAIL="your-email@gmail.com"
APP_PASSWORD="your-google-app-password"

# CORS Whitelist (comma-separated origins)
WHITELIST="http://localhost:5173,http://localhost:3000,http://localhost:4200,http://127.0.0.1:5500"
